html, body {
    width: 100%;
    height: 100%;
    margin: 0;
}

body {
    background-color: aquamarine;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    display: flex;
    justify-content: center;
    align-items: center;
}

form {
    width: 500px;
    padding: 30px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    box-sizing: border-box;
}

h2 {
    text-align: center;
    font-size: 27px;
    margin-bottom: 30px;
}

form div {
    margin-bottom: 20px;
}

label {
    font-size: 20px;
    font-weight: lighter;
}

input {
    width: 100%;
    box-sizing: border-box;
    padding: 12px;
    margin-top: 8px;
    font-size: 18px;
    border: 1px solid #aaa;
    border-radius: 5px;
}

.container-botoes {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-top: 25px;
}

button {

    width: 100%;
    max-width: 180px;
    padding: 15px;
    font-size: 20px;
