<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Minha Biblioteca de Jogos</title>
    <script src="script.js" defer></script>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <form onsubmit="event.preventDefault();">
        
        <h1>Minha Biblioteca de Jogos 🎮</h1>
        <h2>Cadastrar novo jogo 📋</h2>

        <div>
            <label for="nome">Nome do Jogo:</label>
            <input type="text" id="nome" placeholder="Digite o nome do jogo">
        </div>

        <div>
            <label for="genero">Gênero do Jogo:</label>
            <input type="text" id="genero" placeholder="Digite o gênero do jogo">
        </div>

        <div>
            <label for="nota">Nota do Jogo (0, 10):</label>
            <input type="number" id="nota" placeholder="Digite a nota do jogo">
        </div>

        <div class="container-botoes">
            <button type="button" onclick="cadastrarJogo()">
                Adicionar jogo 🎮
            </button>
            <button type="button" onclick="removerUltimoJogo()">
                Remover último ❌
            </button>
        </div>

        <p id="resultado" class="msn"></p>

        <h2>Jogos Cadastrados 🕹️</h2>
        <table border="1" style="border-collapse: collapse; width: 100%; text-align: left;">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Gênero</th>
                    <th>Nota</th>
                </tr>
            </thead>
            <tbody id="lista-jogos">

            </tbody>
        </table>

    </form>
    
</body>
</html>


script:
const jogos = [];

function cadastrarJogo() {
    const nome = document.getElementById("nome").value;
    const genero = document.getElementById("genero").value;
    const nota = document.getElementById("nota").value;

    const novoJogo = {
        nome: nome,
        genero: genero,
        nota: nota,
    };

    jogos.push(novoJogo);

    atualizarLista();

    document.getElementById("resultado").textContent = `${nome} foi adicionado à biblioteca! 🎮`;

    document.getElementById("nome").value = "";
    document.getElementById("genero").value = "";
    document.getElementById("nota").value = "";
}

function atualizarLista() {
    const corpoTabela = document.getElementById("lista-jogos");

    corpoTabela.innerHTML = "";

    jogos.forEach(jogo => {
        const linha = `
            <tr>
                <td>${jogo.nome}</td>
                <td>${jogo.genero}</td>
                <td>${jogo.nota}</td>
            </tr>
        `;
        corpoTabela.innerHTML += linha;
    });
}

function removerUltimoJogo() {

    const jogoRemovido = jogos.pop();

    atualizarLista();

    document.getElementById("resultado").textContent = `${jogoRemovido.nome} foi removido da biblioteca! ❌`;
}

